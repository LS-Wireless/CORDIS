# =============================================================================
# CORDIS — .gitignore
# =============================================================================
# Sections:
#   1. Python runtime artefacts
#   2. Virtual environments
#   3. IDEs and editors
#   4. OS junk
#   5. CORDIS simulation outputs  ← project-specific
#   6. CORDIS configs (what to keep vs. ignore)
#   7. Jupyter notebooks
#   8. Testing and coverage
#   9. Build and packaging
#  10. Documentation build


# =============================================================================
# 1. Python runtime artefacts
# =============================================================================
__pycache__/
*.py[cod]           # .pyc  .pyo  .pyd
*$py.class
*.pyo

# C extensions compiled by Cython or ctypes
*.so
*.pyd

# Bytecode caches (pip, setuptools, etc.)
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/


# =============================================================================
# 2. Virtual environments
# =============================================================================
.venv/
venv/
env/
ENV/
.env/
.conda/
conda-env/


# =============================================================================
# 3. IDEs and editors
# =============================================================================

# PyCharm / IntelliJ
.idea/
*.iml
*.iws
*.ipr

# VS Code
.vscode/
*.code-workspace

# Spyder
.spyderproject.db
.spyproject/

# Vim / Neovim
*.swp
*.swo
*~
Session.vim

# Emacs
\#*\#
.\#*

# Sublime Text
*.sublime-project
*.sublime-workspace

# macOS Xcode
xcuserdata/


# =============================================================================
# 4. OS junk
# =============================================================================

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*


# =============================================================================
# 5. CORDIS simulation outputs
# =============================================================================
# Raw result files (.npz arrays + JSON sidecars) can be large and are
# reproducible from the seed files committed in results/seeds/.
# Figures are also reproducible.  Neither belongs in git.

results/*.npz
results/*_meta.json
results/figures/
results/logs/

# Keep the seeds directory and its contents (these ARE committed — they
# are the reproducibility anchor that lets anyone regenerate every figure)
!results/seeds/
!results/seeds/*.json

# Keep the .gitkeep placeholder so the results/ dir exists after clone
!results/.gitkeep

# Evaluation / sanity-check outputs (reproducible from seeds)
eval/figures/
eval/logs/
eval/datasets/

# Stage 8a
results/
figures/
# Keep the .gitkeep placeholder so the figures/ dir exists after clone
!figures/.gitkeep
# figures_examples/ stays committed; do NOT ignore


# =============================================================================
# 6. CORDIS config files — what to keep vs. ignore
# =============================================================================
# KEEP:   configs/default.json          ← the base everyone starts from
# KEEP:   configs/overrides/*.json      ← reusable partial override sets
# IGNORE: configs/exp_*.json            ← generated by create_config.py;
#                                          they are fully reproducible from
#                                          the --set flags logged in your notes
#                                          or lab notebook.
#
# If you want a specific experiment config to be reproducible by
# collaborators, commit it explicitly:
#   git add -f configs/exp_important.json

configs/exp_*.json
configs/mmwave/
configs/local/

# Temporary override files that are never meant to be shared
configs/tmp_*.json
configs/scratch_*.json


# =============================================================================
# 7. Jupyter notebooks
# =============================================================================
# Notebook outputs (cell outputs, widget state) are noisy diffs and can
# contain large arrays or figures.  Strip them before committing.
# The notebook files themselves (.ipynb) ARE kept.
.ipynb_checkpoints/

# Uncomment if you prefer to ignore all notebooks entirely:
# notebooks/*.ipynb


# =============================================================================
# 8. Testing and coverage
# =============================================================================
.pytest_cache/
.tox/
.nox/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
*.py,cover
nosetests.xml
test-results/


# =============================================================================
# 9. Build and packaging
# =============================================================================
dist/
build/
*.egg-info/
MANIFEST
pip-wheel-metadata/
.eggs/
*.whl


# =============================================================================
# 10. Documentation build
# =============================================================================
docs/_build/
docs/api/
site/


# =============================================================================
# 11. Profiling and benchmarking artefacts
# =============================================================================
*.prof
*.lprof
*.pstats
profiling/


# =============================================================================
# 12. Miscellaneous
# =============================================================================
# Temporary Python scripts used for one-off debugging
scratch_*.py
tmp_*.py
tmp_*.ipynb
tmp_*.json
tmp_*.txt

# Large data files that should live in a data store, not git
*.hdf5
*.h5
*.pkl
*.pickle
*.mat         # MATLAB files if you export for comparison

# Log files written by the simulation runner
*.log
logs/
